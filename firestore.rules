rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny: Catch-all to deny all unauthorized read/write access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper: Verify user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: Verify the authenticated user is the resource owner
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 1. users/{userId}: User profile document keyed by Auth UID
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 2. resumes/{resumeId}: Uploaded resume metadata
    match /resumes/{resumeId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // 3. resumeAnalyses/{analysisId}: Comprehensive ATS and skill evaluation
    match /resumeAnalyses/{analysisId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // 4. jobAnalyses/{analysisId}: Job matching and skill gap results
    match /jobAnalyses/{analysisId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // 5. interviewSessions/{sessionId}: AI interview questions and prep notes
    match /interviewSessions/{sessionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // 6. test/connection: Diagnostic connectivity probe (read-only for authenticated users)
    match /test/connection {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
